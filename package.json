{
  "name": "pr-status",
  "version": "0.0.0",
  "private": true,
  "description": "A GitHub Action that checks the status of a pull request",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "format": "prettier --write '**/*.{js,ts}'",
    "format-check": "prettier --check '**/*.{js,ts}'",
    "lint": "eslint src/**/*.ts __test__/**/*.ts",
    "package": "ncc build src/main.ts -o dist --source-map --license licenses.txt",
    "test": "(JEST_TEST=true jest && make-coverage-badge --output-path ./badges/coverage.svg) || make-coverage-badge --output-path ./badges/coverage.svg",
    "ci-test": "JEST_TEST=true jest",
    "all": "npm run format && npm run lint && npm run build && npm run package",
    "bundle": "npm run format && npm run package"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grantbirki/pr-status.git"
  },
  "keywords": [
    "actions",
    "github"
  ],
  "author": "Grant Birkinbine",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/github": "^6.0.0",
    "@octokit/plugin-retry": "^6.0.1",
    "dedent-js": "^1.0.1",
    "nunjucks": "^3.2.4"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": ["**/__test__/**/*.test.ts", "**/__test__/**/*.test.js"],
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "moduleFileExtensions": ["ts", "js", "json"],
    "coverageReporters": [
      "json-summary",
      "text",
      "lcov"
    ],
    "collectCoverage": true,
    "collectCoverageFrom": [
      "./src/**"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 98,
        "branches": 87,
        "functions": 99
      }
    }
  },
  "devDependencies": {
    "@babel/plugin-transform-modules-commonjs": "^7.24.8",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.10",
    "@typescript-eslint/eslint-plugin": "^8.36.0",
    "@typescript-eslint/parser": "^8.36.0",
    "@vercel/ncc": "^0.38.1",
    "eslint": "^8.57.0",
    "jest": "^30.0.3",
    "js-yaml": "^4.1.0",
    "make-coverage-badge": "^1.2.0",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.0",
    "typescript": "^5.8.3"
  }
}
