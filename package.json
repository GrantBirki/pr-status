{
  "name": "pr-status",
  "version": "0.0.0",
  "private": true,
  "description": "A GitHub Action that checks the status of a pull request",
  "type": "module",
  "main": "dist/index.js",
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": "24.16.0",
    "npm": "11.13.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "npm run typecheck",
    "package": "ncc build src/index.ts -o dist --source-map --license licenses.txt",
    "coverage-badge": "node scripts/coverage-badge.ts",
    "test": "npm run ci-test && npm run coverage-badge",
    "ci-test": "node --test --test-concurrency=1 --experimental-test-coverage --test-coverage-include='src/**/*.ts' --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 test/*.test.ts test/functions/*.test.ts",
    "all": "npm run typecheck && npm test && npm run package",
    "bundle": "npm run package"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grantbirki/pr-status.git"
  },
  "keywords": [
    "actions",
    "github"
  ],
  "author": "Grant Birkinbine",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "1.11.1",
    "@actions/github": "6.0.1",
    "@octokit/plugin-retry": "6.1.0"
  },
  "devDependencies": {
    "@types/node": "24.12.2",
    "@vercel/ncc": "0.38.4",
    "typescript": "6.0.3"
  }
}
